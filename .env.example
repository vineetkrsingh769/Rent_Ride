# Copy to .env and fill in real values. Never commit .env.

DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/rentride
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:3000

# Production frontend (Vercel) — set on the API host
# FRONTEND_URL=https://your-app.vercel.app

# Production API base — set on Vercel as VITE_API_URL (no trailing slash)
# VITE_API_URL=https://your-api.onrender.com

# Seed accounts (required for npm run seed) — use your own credentials
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_AGENCY_EMAIL=
SEED_AGENCY_PASSWORD=
SEED_CUSTOMER_EMAIL=
SEED_CUSTOMER_PASSWORD=
